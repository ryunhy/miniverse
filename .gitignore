# 依赖与构建
node_modules/
.next/
out/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts

# 环境变量与密钥（严禁提交）
.env
.env.*
!.env.example
*.pem
.vercel/

# 用户数据（上传照片 / 任务 / 场景 / 重建产物）
data/uploads/*
data/processed/*
data/reconstructions/*
data/tasks/*
data/scenes/*
# 公开数据集（mipnerf360 zip + 解压照片，实测 2.67GB，超 GitHub 单文件 100MB 上限）
data/datasets/
# 演示高斯副本：由 tools/generate-demo-splat.mjs 生成，正式文件在 apps/web/public/demo/
data/demo/*
!data/*/.gitkeep

# 改动前快照（入库后 git 自身即备份，避免噪音）
.backup-*/

# Archify 生成的架构图产物（带时间戳目录，每次生成都会变，不入库）
.archify/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 日志与临时文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.alma-snapshots

# 本地运行数据、实验产物与工作区配置
/data/
/outputs/
/.ws*/
/.wslconfig
/_pending-delete-*/
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
/docs/furniture/palette-v*/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Python 测试缓存（0-3 基线钉点时补齐）
.pytest_cache/
