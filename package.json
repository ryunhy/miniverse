{
  "name": "miniverse",
  "version": "0.2.0",
  "private": true,
  "description": "MiniVerse — AI 高保真 3D 重建与交互式微缩世界编辑器",
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "vitest run",
    "tools:glb": "node tools/generate-furniture-glb.mjs",
    "tools:splat": "node tools/generate-demo-splat.mjs"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
